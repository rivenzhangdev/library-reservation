<view class="seat-map-container" id="seatMapContainer">
  <view class="seat-map-header">
    <view class="flex items-center">
      <text class="iconfont icon-chair seat-icon"></text>
      <text class="seat-title">{{seatMapTitle}}</text>
      <text class="seat-subtitle">{{seatMapSubtitle}}</text>
    </view>
  </view>

  <view class="seat-map-content" bindtap="hideSeatTooltip">
    <!-- 座位网格区域（可滚动） -->
    <view wx:if="{{seats.length === 0}}" class="seat-grid empty-state-wrapper">
      <view class="empty-state">
        <text class="empty-icon iconfont icon-chair"></text>
        <text class="empty-text">{{seatMapEmptyText}}</text>
      </view>
    </view>

    <scroll-view
      wx:elif="{{seats.length > 0}}"
      scroll-x="{{true}}"
      scroll-y="{{true}}"
      class="seat-grid-container"
      show-scrollbar="{{false}}"
      bindscroll="handleGridScroll"
    >
      <view class="seat-grid" style="width: {{gridWidth}}rpx;">
        <!-- 座位网格 -->
        <view
          class="grid-layout"
          style="grid-template-columns: repeat({{cols}}, {{seatSize}}rpx); grid-template-rows: repeat({{rows}}, {{seatSize}}rpx);"
        >
          <block wx:for="{{seatMatrix}}" wx:for-item="row" wx:key="index">
            <block wx:for="{{row}}" wx:for-item="cell" wx:key="index">
              <view
                wx:if="{{cell}}"
                id="seat-{{cell.id}}"
                class="seat-item seat-{{cell.status}} {{cell.isMine ? 'seat-mine' : ''}} {{activeSeatId === cell.id ? 'seat-item--active' : ''}}"
                style="width: {{seatSize}}rpx; height: {{seatSize}}rpx;"
                data-id="{{cell.id}}"
                catchtap="handleSeatClick"
              >
                <text class="seat-number">{{cell.row}}-{{cell.col}}</text>
                <view wx:if="{{cell.hasSocket}}" class="socket-icon">
                  <text class="iconfont icon-plug"></text>
                </view>
                <view wx:if="{{cell.isWindow}}" class="window-label">{{seatMapWindow}}</view>
              </view>
              <view
                wx:elif="{{!cell}}"
                class="seat-item seat-empty"
                style="width: {{seatSize}}rpx; height: {{seatSize}}rpx;"
              />
            </block>
          </block>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{activeSeat}}" class="seat-tooltip" style="{{seatTooltipStyle}}" catchtap="noop">
      <view class="seat-tooltip-arrow {{tooltipDirection}}" style="{{seatTooltipArrowStyle}}"></view>
      <view class="seat-tooltip-panel">
        <view class="seat-tooltip-header-row">
          <view class="seat-tooltip-header-dot seat-tooltip-header-dot-{{activeSeat.isMine ? 'mine' : activeSeat.status}}"></view>
          <text class="seat-tooltip-header">{{seatTooltipHeader}}</text>
        </view>
        <text class="seat-tooltip-title">{{activeSeat.zone || '区'}} {{activeSeat.row}} - {{activeSeat.col}}</text>
        <view wx:if="{{activeSeat.tags && activeSeat.tags.length > 0}}" class="seat-tooltip-tags">
          <text wx:for="{{activeSeat.tags}}" wx:key="index" class="seat-tooltip-tag">{{item}}</text>
        </view>
        <text wx:if="{{seatTooltipRows.length === 0}}" class="seat-tooltip-status">{{seatTooltipStatus}}</text>
        <block wx:for="{{seatTooltipRows}}" wx:key="key">
          <view class="seat-tooltip-row seat-tooltip-row-{{item.type}}">
            <text class="seat-tooltip-row-label">{{item.label}}</text>
            <text class="seat-tooltip-row-time">{{item.timeLabel}}</text>
            <text class="seat-tooltip-row-status">{{item.statusText}}</text>
          </view>
        </block>
        <text wx:if="{{seatTooltipRows.length === 0}}" class="seat-tooltip-desc">{{seatTooltipDescription}}</text>
      </view>
    </view>

    <view class="legend-container">
      <view class="legend-item">
        <view class="legend-icon legend-available"></view>
        <text class="legend-text">{{seatMapLegendAvailable}}</text>
        <text class="legend-desc">{{seatMapLegendAvailableDesc}}</text>
      </view>

      <view class="legend-item">
        <view class="legend-icon legend-booked"></view>
        <text class="legend-text">{{seatMapLegendBooked}}</text>
        <text class="legend-desc">{{seatMapLegendBookedDesc}}</text>
      </view>

      <view class="legend-item">
        <view class="legend-icon legend-maintenance"></view>
        <text class="legend-text">{{seatMapLegendMaintenance}}</text>
        <text class="legend-desc">{{seatMapLegendMaintenanceDesc}}</text>
      </view>

      <view class="legend-item">
        <view class="legend-icon legend-selected"></view>
        <text class="legend-text">{{seatMapLegendSelected}}</text>
        <text class="legend-desc">{{seatMapLegendSelectedDesc}}</text>
      </view>

      <view class="legend-item">
        <view class="legend-icon legend-mine"></view>
        <text class="legend-text">{{seatMapLegendMine}}</text>
        <text class="legend-desc">{{seatMapLegendMineDesc}}</text>
      </view>
    </view>

    <text class="instruction-text"> {{seatMapInstruction}} </text>
  </view>
</view>
