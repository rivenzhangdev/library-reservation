<!-- 座位列表项组件 -->
<view class="seat-item">
  <!-- 卡片头部：座位信息 -->
  <view class="seat-item__header">
    <view class="seat-item__info">
      <view class="seat-item__icon">
        <uni-icon type="vant" name="{{icon}}" size="40" custom-class="seat-item__iconfont" />
      </view>
      <view class="seat-item__text">
        <text class="seat-item__label">{{seatLabel}}</text>
        <text class="seat-item__name">{{seatName}}</text>
      </view>
    </view>
    <view class="seat-item__status" wx:if="{{status === 'available'}}">
      <text class="seat-item__status-text">可用</text>
    </view>
  </view>

  <!-- 卡片中部：座位属性 -->
  <view class="seat-item__attributes">
    <view class="seat-item__attribute">
      <text class="seat-item__attribute-text">{{seatType}}</text>
    </view>
    <view class="seat-item__attribute">
      <text class="seat-item__attribute-text">{{distance}}</text>
    </view>
  </view>

  <!-- 卡片底部：操作按钮 -->
  <view class="seat-item__footer">
    <button class="seat-item__btn seat-item__btn--primary" bindtap="onReserve">立即预约</button>
    <view class="seat-item__btn seat-item__btn--icon" bindtap="onFavorite">
      <uni-icon type="vant" name="star-o" size="32" custom-class="seat-item__iconfont" />
    </view>
  </view>
</view>
