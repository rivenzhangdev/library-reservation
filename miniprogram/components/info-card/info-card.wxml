<!-- 信息卡片组件 - 通用信息展示卡片 -->
<view class="info-card">
  <!-- 背景装饰 -->
  <view class="info-card-decoration decoration-top-left"></view>
  <view class="info-card-decoration decoration-bottom-right"></view>

  <!-- 头像/主图标 -->
  <view class="info-card-avatar">
    <view class="avatar-circle">
      <uni-icon type="vant" name="{{avatarIcon}}" size="{{avatarSize}}" color="#fff" />
    </view>
  </view>

  <!-- 信息内容 -->
  <view class="info-card-content">
    <view class="info-card-title" wx:if="{{title}}">{{title}}</view>

    <!-- 副标题/等级（可选） -->
    <view class="info-card-subtitle" wx:if="{{subtitle}}"> {{subtitle}} </view>

    <!-- 详细信息列表 -->
    <view class="info-card-details" wx:if="{{details.length > 0}}">
      <view class="info-card-detail-item" wx:for="{{details}}" wx:key="id">
        <uni-icon
          type="vant"
          name="{{item.icon}}"
          size="{{item.iconSize}}"
          color="{{item.iconColor}}"
        />
        <text class="detail-text">{{item.text}}</text>
      </view>
    </view>

    <!-- 统计数据（可选） -->
    <view class="info-card-stats" wx:if="{{stats.length > 0}}">
      <view class="info-card-stat-item" wx:for="{{stats}}" wx:key="id">
        <uni-icon type="vant" name="{{item.icon}}" size="{{item.iconSize}}" color="#fff" />
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>
</view>
