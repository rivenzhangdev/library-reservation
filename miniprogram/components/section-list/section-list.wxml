<!-- 通用模块容器组件 -->
<view class="section-list {{containerClass}}">
  <!-- 标题 -->
  <view class="section-title" wx:if="{{title}}">{{title}}</view>

  <!-- 列表内容 -->
  <view class="section-list-content">
    <view
      wx:for="{{items}}"
      wx:key="index"
      class="section-list-item {{item.disabled ? 'section-list-item--disabled' : ''}}"
      data-action="{{item.action}}"
      data-disabled="{{item.disabled}}"
      bind:tap="onItemTap"
    >
      <content-card
        mode="list"
        icon="{{item.iconName || ''}}"
        iconColor="{{item.iconColor}}"
        iconBgColor="{{item.iconBgColor}}"
        title="{{item.label}}"
        badgeCount="{{item.badgeCount || 0}}"
        clickable="false"
        enableHover="false"
      />
    </view>
  </view>
</view>
