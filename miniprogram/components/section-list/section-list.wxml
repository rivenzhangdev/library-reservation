<!-- 通用模块容器组件 -->
<view class="section-list {{containerClass}}">
  <!-- 标题 -->
  <view class="section-title" wx:if="{{title}}">{{title}}</view>

  <!-- 列表内容 -->
  <view class="section-list-content">
    <content-card
      wx:for="{{items}}"
      wx:key="id"
      mode="list"
      icon="{{item.iconName || ''}}"
      iconColor="{{item.iconColor}}"
      iconBgColor="{{item.iconBgColor}}"
      title="{{item.label}}"
      badgeCount="{{item.badgeCount || 0}}"
      clickable="{{item.clickable !== false}}"
      enableHover="{{enableHover}}"
      bind:tap="onItemTap"
    />
  </view>
</view>
