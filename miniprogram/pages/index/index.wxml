<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{false}}">
    <view slot="right" class="nav-right">
      <view class="lang-switch-btn" bind:tap="onSwitchLanguage">
        <text>{{currentLang === 'zh' ? 'EN' : '中文'}}</text>
      </view>
    </view>
  </navigation-bar>
</page-meta>

<view class="page-container {{languageClass}}">
  <view class="search-area">
    <van-search
      class="search-input"
      value="{{value}}"
      shape="round"
      placeholder="{{searchPlaceholder}}"
      bind:search="onSearchConfirm"
    />
    <scroll-view class="search-tag" scroll-x enable-flex>
      <view
        class="search-tag-item"
        wx:for="{{searchTags}}"
        wx:key="key"
        bind:tap="onSearchTagTap"
        data-tag-type="{{item.filterType}}"
        data-tag-value="{{item.filterValue}}"
        data-tag-label="{{item.label}}"
      >
        <uni-icon type="vant" name="{{item.icon}}" size="28" color="#409eff" />
        <text>{{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="swiper-area">
    <swiper indicator-dots="{{true}}" autoplay="{{true}}" interval="3000" duration="1000">
      <swiper-item wx:for="{{displayBanners}}" wx:key="activityId">
        <view class="banner-item" bind:tap="onBannerTap" data-id="{{item.activityId}}">
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" />
          <view wx:else class="banner-placeholder">
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-subtitle">{{openingHoursTime}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view class="action-area">
    <view
      class="action-card"
      wx:for="{{actionCards}}"
      wx:key="id"
      bind:tap="onActionCardTap"
      data-id="{{item.id}}"
    >
      <uni-icon type="{{item.iconType}}" name="{{item.icon}}" size="50" color="#409eff" />
      <text class="action-text">{{item.text}}</text>
    </view>
  </view>

  <view class="opening-hours">
    <view class="opening-hours-content">
      <view class="opening-hours-icon">
        <uni-icon type="vant" name="clock-o" size="48" color="#2ecc71" />
      </view>
      <view class="opening-hours-info">
        <view class="opening-hours-title">{{openingHoursTitle}}</view>
        <view class="opening-hours-time">{{openingHoursTime}}</view>
      </view>
    </view>
    <van-tag type="success" size="medium" class="opening-hours-status">
      {{openingHoursStatus}}
    </van-tag>
  </view>

  <common-card class="seat-section" title="{{seatStatusTitle}}">
    <view class="seat-status-grid">
      <view class="seat-status-card">
        <view class="seat-status-header">
          <view class="seat-status-icon seat-status-icon--blue">
            <uni-icon type="vant" name="cluster-o" size="28" color="#fff" />
          </view>
          <text class="seat-status-label">{{seatStatus.total.label}}</text>
        </view>
        <view class="seat-status-value">{{seatStatus.total.value}}</view>
      </view>

      <view class="seat-status-card">
        <view class="seat-status-header">
          <view class="seat-status-icon seat-status-icon--green">
            <uni-icon type="vant" name="passed" size="28" color="#fff" />
          </view>
          <text class="seat-status-label">{{seatStatus.available.label}}</text>
          <view class="seat-status-percent">{{seatStatus.available.percent}}</view>
        </view>
        <view class="seat-status-value">{{seatStatus.available.value}}</view>
        <view class="seat-status-progress">
          <view
            class="seat-status-progress-bar"
            style="width: {{seatStatus.available.percent}}; background-color: #2ecc71"
          ></view>
          <view class="seat-status-progress-bg"></view>
        </view>
      </view>

      <view class="seat-status-card">
        <view class="seat-status-header">
          <view class="seat-status-icon seat-status-icon--red">
            <uni-icon type="vant" name="clock-o" size="28" color="#fff" />
          </view>
          <text class="seat-status-label">{{seatStatus.reserved.label}}</text>
          <view class="seat-status-percent">{{seatStatus.reserved.percent}}</view>
        </view>
        <view class="seat-status-value">{{seatStatus.reserved.value}}</view>
        <view class="seat-status-progress">
          <view
            class="seat-status-progress-bar"
            style="width: {{seatStatus.reserved.percent}}; background-color: #e74c3c"
          ></view>
          <view class="seat-status-progress-bg"></view>
        </view>
      </view>

      <view class="seat-status-card">
        <view class="seat-status-header">
          <view class="seat-status-icon seat-status-icon--gray">
            <uni-icon type="vant" name="underway-o" size="28" color="#fff" />
          </view>
          <text class="seat-status-label">{{seatStatus.maintenance.label}}</text>
          <view class="seat-status-percent">{{seatStatus.maintenance.percent}}</view>
        </view>
        <view class="seat-status-value">{{seatStatus.maintenance.value}}</view>
        <view class="seat-status-progress">
          <view
            class="seat-status-progress-bar"
            style="width: {{seatStatus.maintenance.percent}}; background-color: #95a5a6"
          ></view>
          <view class="seat-status-progress-bg"></view>
        </view>
      </view>
    </view>

    <view class="trend-chart-wrapper">
      <ec-canvas id="echart" canvas-id="echart" ec="{{ec}}"></ec-canvas>
    </view>
  </common-card>

  <common-card class="info-section" title="{{realTimeTitle}}">
    <grid-container>
      <grid-item
        wx:for="{{realTimeItems}}"
        wx:key="label"
        mode="simple"
        iconType="vant"
        icon="{{item.icon}}"
        label="{{item.label}}"
        value="{{item.value}}"
        sublabel="{{item.sublabel}}"
        bgColor="{{item.bgColor}}"
        iconColor="{{item.iconColor}}"
      />
    </grid-container>
  </common-card>

  <common-card class="seat-recommend-section" title="{{recommendTitle}}">
    <view slot="header-action" class="view-all" bind:tap="onViewAllSeats">
      <text class="view-all-text">{{viewAllText}}</text>
      <uni-icon type="vant" name="arrow" size="28" color="#666" />
    </view>

    <view class="seat-list">
      <grid-item
        wx:for="{{seatList}}"
        wx:key="seatId"
        mode="card"
        name="{{item.seatName}}"
        statusText="{{item.statusText}}"
        attributes="{{item.attributes}}"
        showFooter="{{true}}"
        clickable="{{false}}"
      >
        <view slot="footer" class="seat-footer">
          <view class="seat-footer__left">
            <van-button
              type="primary"
              size="small"
              class="seat-footer__reserve"
              bind:click="onSeatReserve"
              data-index="{{index}}"
            >
              {{reserveButtonText}}
            </van-button>
            <view
              class="seat-footer__favorite {{item.isFavorite ? 'active' : ''}}"
              bind:tap="onSeatFavorite"
              data-index="{{index}}"
            >
              <uni-icon
                type="vant"
                name="{{item.isFavorite ? 'star' : 'star-o'}}"
                size="32"
                color="{{item.isFavorite ? '#f59e0b' : '#909399'}}"
              />
            </view>
          </view>
          <view class="seat-footer__arrow" bind:tap="onSeatReserve" data-index="{{index}}">
            <uni-icon type="vant" name="arrow" size="32" color="#999" />
          </view>
        </view>
      </grid-item>
    </view>
  </common-card>

  <common-card class="activity-section" title="{{activityTitle}}">
    <view slot="header-action" class="view-all" bind:tap="onViewMoreActivities">
      <text class="view-all-text">{{viewMoreActivity}}</text>
      <uni-icon type="vant" name="arrow" size="28" color="#666" />
    </view>

    <view class="activity-list">
      <content-card
        wx:for="{{activityList}}"
        wx:key="id"
        mode="card"
        icon="gift-o"
        iconBgColor="#e8f4ff"
        iconColor="#409eff"
        title="{{item.title}}"
        desc="{{item.desc}}"
        status="{{item.status}}"
        statusText="{{item.statusText}}"
        time="{{item.time}}"
        btnText="{{item.btnText}}"
        disabled="{{item.disabled}}"
        clickable="{{false}}"
        bind:btnTap="onActivityBtnTap"
        btnDataId="{{item.id}}"
        data-index="{{index}}"
      />
    </view>
  </common-card>
</view>
