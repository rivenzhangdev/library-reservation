<!-- 导航栏 -->
<navigation-bar title="图书馆座位预约" back="{{false}}" />

<!-- 页面容器 -->
<view class="page-container">
  <!-- 搜索区域 -->
  <view class="search-area">
    <van-search
      class="search-input"
      value="{{ value }}"
      shape="round"
      placeholder="请输入搜索关键词"
    />
    <!-- 搜索标签 -->
    <scroll-view class="search-tag" scroll-x enable-flex>
      <view class="search-tag-item">
        <view class="iconfont icon-home search-tag-icon"></view>
        <text>有插座</text>
      </view>
      <view class="search-tag-item">
        <view class="iconfont icon-home search-tag-icon"></view>
        <text>靠窗</text>
      </view>
      <view class="search-tag-item">
        <view class="iconfont icon-home search-tag-icon"></view>
        <text>单人桌</text>
      </view>
      <view class="search-tag-item">
        <view class="iconfont icon-home search-tag-icon"></view>
        <text>双人桌</text>
      </view>
      <view class="search-tag-item">
        <view class="iconfont icon-home search-tag-icon"></view>
        <text>小组讨论桌</text>
      </view>
    </scroll-view>
  </view>

  <!-- 轮播图 -->
  <view class="swiper-area">
    <swiper indicator-dots="{{true}}" autoplay="{{true}}" interval="3000" duration="1000">
      <swiper-item>
        <image src="https://picsum.photos/seed/picsum/200/300" mode="aspectFill" />
      </swiper-item>
      <swiper-item>
        <image src="https://picsum.photos/seed/picsum/200/300" mode="aspectFill" />
      </swiper-item>
      <swiper-item>
        <image src="https://picsum.photos/seed/picsum/200/300" mode="aspectFill" />
      </swiper-item>
    </swiper>
  </view>

  <!-- 功能卡片区域 -->
  <view class="action-area">
    <view class="action-card">
      <view class="iconfont icon-home action-icon" style="color: #409eff"></view>
      <text class="action-text">立即预约</text>
    </view>
    <view class="action-card">
      <view class="action-icon-wrapper">
        <view class="iconfont icon-home action-icon" style="color: #9b59b6"></view>
      </view>
      <text class="action-text">我的预约</text>
    </view>
    <view class="action-card">
      <view class="action-icon-wrapper">
        <view class="iconfont icon-home action-icon" style="color: #2ecc71"></view>
      </view>
      <text class="action-text">快速续约</text>
    </view>
    <view class="action-card">
      <view class="action-icon-wrapper">
        <view class="iconfont icon-home action-icon" style="color: #e67e22"></view>
      </view>
      <text class="action-text">扫码签到</text>
    </view>
  </view>

  <!-- 今日开放时间 -->
  <view class="opening-hours">
    <view class="opening-hours-content">
      <view class="opening-hours-icon">
        <view class="iconfont icon-home" style="color: #2ecc71"></view>
      </view>
      <view class="opening-hours-info">
        <view class="opening-hours-title">今日开放时间</view>
        <view class="opening-hours-time">08:00 - 22:00</view>
      </view>
    </view>
    <view class="opening-hours-status">营业中</view>
  </view>

  <!-- 座位状态概览数据统计 -->
  <common-card class="seat-section" title="座位状态概览">
    <view class="seat-status-grid">
      <!-- 总座位数 -->
      <view class="seat-status-card">
        <view class="seat-status-header">
          <view class="seat-status-icon" style="background-color: #409eff">
            <view class="iconfont icon-home"></view>
          </view>
          <text class="seat-status-label">总座位数</text>
        </view>
        <view class="seat-status-value">500</view>
      </view>

      <!-- 可用座位 -->
      <view class="seat-status-card">
        <view class="seat-status-header">
          <view class="seat-status-icon" style="background-color: #2ecc71">
            <view class="iconfont icon-success"></view>
          </view>
          <text class="seat-status-label">可用座位</text>
          <view class="seat-status-percent">64%</view>
        </view>
        <view class="seat-status-value">320</view>
        <view class="seat-status-progress">
          <view
            class="seat-status-progress-bar"
            style="width: 64%; background-color: #2ecc71"
          ></view>
          <view class="seat-status-progress-bg"></view>
        </view>
      </view>

      <!-- 已预约座位 -->
      <view class="seat-status-card">
        <view class="seat-status-header">
          <view class="seat-status-icon" style="background-color: #e74c3c">
            <view class="iconfont icon-calendar"></view>
          </view>
          <text class="seat-status-label">已预约座位</text>
          <view class="seat-status-percent">30%</view>
        </view>
        <view class="seat-status-value">150</view>
        <view class="seat-status-progress">
          <view
            class="seat-status-progress-bar"
            style="width: 30%; background-color: #e74c3c"
          ></view>
          <view class="seat-status-progress-bg"></view>
        </view>
      </view>

      <!-- 维修中座位 -->
      <view class="seat-status-card">
        <view class="seat-status-header">
          <view class="seat-status-icon" style="background-color: #95a5a6">
            <view class="iconfont icon-tools"></view>
          </view>
          <text class="seat-status-label">维修中座位</text>
          <view class="seat-status-percent">6%</view>
        </view>
        <view class="seat-status-value">30</view>
        <view class="seat-status-progress">
          <view
            class="seat-status-progress-bar"
            style="width: 6%; background-color: #95a5a6"
          ></view>
          <view class="seat-status-progress-bg"></view>
        </view>
      </view>
    </view>
  </common-card>

  <!-- 实时信息 -->
  <common-card class="info-section" title="实时信息">
    <!-- 信息网格 -->
    <info-grid>
      <info-grid-item
        icon="home"
        label="图书馆内用户数量"
        value="280"
        sublabel="当前在线人数"
        bgColor="#e8f4ff"
        iconColor="#409eff"
      />
      <info-grid-item
        icon="home"
        label="舒适阅读环境"
        value="24℃"
        sublabel="图书馆温度"
        bgColor="#fff7e8"
        iconColor="#e6a23c"
      />
      <info-grid-item
        icon="home"
        label="安静适宜学习"
        value="45dB"
        sublabel="噪音指数"
        bgColor="#e8f9f0"
        iconColor="#2ecc71"
      />
      <info-grid-item
        icon="home"
        label="当前最受欢迎区域"
        value="A 区 2 楼"
        sublabel="热门区域"
        bgColor="#ffe8e8"
        iconColor="#e74c3c"
      />
      <info-grid-item
        icon="home"
        label="今日已预约座位"
        value="156"
        sublabel="当前预约数"
        bgColor="#f3e8ff"
        iconColor="#9b59b6"
      />
      <info-grid-item
        icon="home"
        label="今日预约总量"
        value="325"
        sublabel="今日总预约"
        bgColor="#e8f0ff"
        iconColor="#3498db"
      />
    </info-grid>
  </common-card>

  <!-- 推荐座位 -->
  <common-card class="seat-recommend-section" title="推荐座位">
    <view slot="header-action" class="view-all">
      <text class="view-all-text">查看全部</text>
      <view class="iconfont icon-arrow view-all-icon"></view>
    </view>

    <!-- 座位列表 -->
    <view class="seat-list">
      <seat-item
        seat-label="靠窗座位"
        seat-name="A1"
        seat-type="单人桌"
        distance="25m"
        status="available"
        icon="icon-home"
        bind:reserve="onSeatReserve"
        bind:favorite="onSeatFavorite"
        bind:detail="onSeatDetail"
      />
      <seat-item
        seat-label="安静座位"
        seat-name="B12"
        seat-type="单人桌"
        distance="15m"
        status="available"
        icon="icon-home"
        bind:reserve="onSeatReserve"
        bind:favorite="onSeatFavorite"
        bind:detail="onSeatDetail"
      />
      <seat-item
        seat-label="插座座位"
        seat-name="C08"
        seat-type="双人桌"
        distance="30m"
        status="available"
        icon="icon-home"
        bind:reserve="onSeatReserve"
        bind:favorite="onSeatFavorite"
        bind:detail="onSeatDetail"
      />
    </view>
  </common-card>
</view>
