<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{true}}" />
</page-meta>

<view class="page-container {{languageClass}}">
  <scroll-view class="status-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="status-list">
      <view
        wx:for="{{statusList}}"
        wx:key="id"
        class="status-item {{currentStatus === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bind:tap="onStatusTap"
      >
        <text class="status-text">{{item.name}}</text>
        <text class="status-badge">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="reservation-list">
    <block wx:for="{{filteredReservations}}" wx:key="id">
      <common-card>
        <view class="reservation-top">
          <view class="reservation-title-group">
            <text class="reservation-title">{{item.seatName}}</text>
            <text class="reservation-subtitle">{{item.description || item.locationLabel}}</text>
          </view>
          <van-tag type="{{item.tagType}}" size="medium">{{item.statusName}}</van-tag>
        </view>

        <view class="reservation-meta-row">
          <view class="reservation-meta-info">
            <view class="reservation-meta-time-badge">
              <text class="reservation-meta-time">{{item.timeRange}}</text>
            </view>
            <text class="reservation-meta-date">{{item.date}}</text>
          </view>

          <view class="reservation-actions">
            <view class="reservation-action-group">
              <block wx:if="{{item.status === 'ongoing'}}">
                <van-button size="small" type="primary" plain bind:tap="onCheckinTap" data-id="{{item.id}}">{{actionCheckinText}}</van-button>
                <van-button size="small" type="info" plain bind:tap="onCancelTap" data-id="{{item.id}}">{{actionCancelText}}</van-button>
              </block>
              <block wx:if="{{item.status === 'upcoming'}}">
                <van-button size="small" type="primary" plain bind:tap="onRenewTap" data-id="{{item.id}}">{{actionRenewText}}</van-button>
                <van-button size="small" type="info" plain bind:tap="onCancelTap" data-id="{{item.id}}">{{actionCancelText}}</van-button>
              </block>
            </view>
          </view>
        </view>

        <view wx:if="{{item.region || item.seatType || item.booking.checkinTime || item.booking.checkedInAt}}" class="reservation-additional">
          <text wx:if="{{item.region}}">{{item.region}}</text>
          <text wx:if="{{item.region && item.seatType}}"> · </text>
          <text wx:if="{{item.seatType}}">{{item.seatType}}</text>
          <text wx:if="{{(item.region || item.seatType) && (item.booking.checkinTime || item.booking.checkedInAt)}}"> · </text>
          <text wx:if="{{item.booking.checkinTime || item.booking.checkedInAt}}">{{item.booking.checkinTime || item.booking.checkedInAt}}</text>
        </view>
      </common-card>
    </block>
  </view>

  <view wx:if="{{filteredReservations.length === 0}}" class="empty-state">
    <uni-icon name="orders-o" size="80" color="#dcdee0" type="vant" />
    <text class="empty-text">{{emptyHint}}</text>
  </view>
</view>
