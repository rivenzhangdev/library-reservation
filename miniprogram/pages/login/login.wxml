<page-meta>
  <navigation-bar title="{{pageTitle}}" back="false" />
</page-meta>

<view class="page-container {{languageClass}}">
  <view class="login-card">
    <view class="login-icon-wrapper">
      <view class="login-icon-bg">
        <uni-icon type="vant" name="notes-o" size="52" color="#34c26f" />
      </view>
    </view>

    <view class="login-brand-title">{{brandTitle}}</view>
    <view class="login-brand-subtitle">{{brandSubtitle}}</view>
    <view class="login-description">{{description}}</view>

    <button class="login-button" bind:tap="onLoginTap" type="primary">
      <view class="login-button-content">
        <uni-icon type="vant" name="wechat" size="30" color="#ffffff" />
        <text class="login-button-text">{{buttonText}}</text>
      </view>
    </button>

    <view class="login-agreement">
      <text>{{agreementText}}</text>
      <text class="login-link" bindtap="onAgreementTap">《用户协议》</text>
      <text> 和 </text>
      <text class="login-link" bindtap="onPrivacyTap">《隐私政策》</text>
    </view>
  </view>
</view>
