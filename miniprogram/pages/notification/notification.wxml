<!-- 通知页面 -->
<page-meta>
  <!-- 导航栏 -->
  <navigation-bar title="{{pageTitle}}" back="{{false}}" />
</page-meta>

<!-- 页面容器 -->
<view class="page-container {{languageClass}}">
  <!-- 筛选标签栏 -->
  <van-tabs
    sticky
    animated
    color="#409eff"
    title-active-color="#409eff"
    line-height="6rpx"
    line-width="48rpx"
    bind:change="onFilterChange"
  >
    <van-tab
      wx:for="{{filterTabs}}"
      wx:key="value"
      data-value="{{item.value}}"
      title="{{item.label}}"
    >
      <view wx:if="{{item.badge > 0}}" slot="title">
        <view class="tab-with-badge">
          <text>{{item.label}}</text>
          <view class="tab-badge">{{item.badge}}</view>
        </view>
      </view>
    </van-tab>
  </van-tabs>

  <!-- 全部已读按钮 -->
  <view class="actions-bar" wx:if="{{hasUnread}}">
    <view
      class="mark-all-read-btn"
      hover-class="button-hover"
      hover-stay-time="150"
      bind:tap="onMarkAllRead"
    >
      <uni-icon type="vant" name="checked" size="32" color="#fff" />
      <text>{{markAllReadText}}</text>
    </view>
  </view>

  <!-- 通知列表 -->
  <view class="notification-list">
    <view
      wx:for="{{notificationList}}"
      wx:key="id"
      class="notification-item-card {{!item.isRead ? 'notification-item-card--unread' : ''}}"
    >
      <view class="notification-item-header">
        <view class="notification-item-title-group">
          <text class="notification-item-title">{{item.title}}</text>
          <text class="notification-item-subtitle">{{item.content}}</text>
        </view>
        <van-tag type="primary" size="small" class="notification-item-tag">
          {{item.typeText}}
        </van-tag>
      </view>
      <view class="notification-item-info">
        <text class="notification-item-time">{{item.time}}</text>
      </view>
      <view class="notification-item-actions">
        <text
          class="notification-action"
          data-id="{{item.id}}"
          data-action="viewDetail"
          bindtap="onActionTap"
        >
          {{viewDetailText}}
        </text>
        <text
          wx:if="{{!item.isRead}}"
          class="notification-action"
          data-id="{{item.id}}"
          data-action="markRead"
          bindtap="onActionTap"
        >
          {{markReadText}}
        </text>
        <uni-icon
          type="vant"
          name="delete-o"
          size="34"
          color="#999"
          bindtap="onActionTap"
          data-action="delete"
          data-id="{{item.id}}"
          class="notification-delete-icon"
        />
      </view>
    </view>

    <!-- 空状态提示 -->
    <view class="empty-state" wx:if="{{notificationList.length === 0}}">
      <uni-icon type="vant" name="bell" size="80" color="#ddd" />
      <text class="empty-text">{{emptyText}}</text>
    </view>
  </view>
</view>
