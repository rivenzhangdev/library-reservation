<page-meta>
  <navigation-bar title="{{navTitle}}" background-color="#ffffff" text-color="#000000" />
</page-meta>

<view class="page-container">
  <!-- 常用座位区域 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">{{favoriteSeatsTitle}}</view>
      <view class="section-count">{{favoriteSeatsCount}} 个</view>
    </view>

    <view class="cards-container" wx:if="{{favoriteSeats.length > 0}}">
      <view
        wx:for="{{favoriteSeats}}"
        wx:key="id"
        class="collection-card"
        data-id="{{item.id}}"
        data-seat-name="{{item.seatName}}"
        data-seat-id="{{item.seatId}}"
        data-zone="{{item.zone}}"
        data-floor="{{item.floor}}"
        data-type="{{item.type}}"
        data-facilities="{{item.facilities}}"
        data-status="{{item.status}}"
      >
        <view class="collection-card-left">
          <view class="collection-card-header">
            <view class="collection-card-title">{{item.seatName}}</view>
            <van-tag
              type="{{item.status === 'available' ? 'success' : (item.status === 'booked' ? 'primary' : 'default')}}"
              size="medium"
            >
              {{item.status === 'available' ? '可用' : (item.status === 'booked' ? '已预约' :
              '维修中')}}
            </van-tag>
          </view>
          <view class="collection-card-desc">
            <uni-icon name="location-o" size="28" type="vant" color="#969799" />
            <text>{{item.zone}} · {{item.type}}</text>
          </view>
          <view class="collection-card-facilities">
            <van-tag
              wx:for="{{item.facilities}}"
              wx:key="*this"
              type="default"
              plain
              size="medium"
              class="facility-tag"
            >
              {{item}}
            </van-tag>
          </view>
        </view>
        <view class="collection-card-right">
          <view class="collection-card-actions">
            <van-button
              wx:if="{{item.status === 'available'}}"
              type="primary"
              size="small"
              round
              class="action-btn"
              bind:tap="onQuickReserveSeat"
              data-id="{{item.id}}"
              data-seat-name="{{item.seatName}}"
              data-seat-id="{{item.seatId}}"
              data-zone="{{item.zone}}"
              data-floor="{{item.floor}}"
              data-type="{{item.type}}"
              data-facilities="{{item.facilities}}"
              data-status="{{item.status}}"
            >
              {{quickReserveText}}
            </van-button>
            <van-button wx:else type="default" size="small" round class="action-btn" disabled>
              {{quickReserveText}}
            </van-button>
            <view
              class="unfavorite-btn"
              bind:tap="onUnfavoriteSeat"
              data-id="{{item.id}}"
              data-name="{{item.seatName}}"
            >
              <uni-icon name="star" size="36" type="vant" color="#969799" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <uni-icon name="star-o" size="120" type="vant" color="#dcdee0" />
      <view class="empty-text">{{emptySeatHint}}</view>
    </view>
  </view>

  <!-- 常用时段区域 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">{{favoriteTimeSlotsTitle}}</view>
      <view class="section-count">{{totalCount}} 个</view>
    </view>

    <view class="cards-container" wx:if="{{favoriteTimeSlots.length > 0}}">
      <view
        wx:for="{{favoriteTimeSlots}}"
        wx:key="id"
        class="collection-card time-card"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        data-start-time="{{item.startTime}}"
        data-end-time="{{item.endTime}}"
        data-usage-count="{{item.usageCount}}"
      >
        <view class="collection-card-left">
          <view class="collection-card-title">{{item.name}}</view>
          <view class="collection-card-time">
            <uni-icon name="clock-o" size="28" type="vant" color="#969799" />
            <text>{{item.startTime}} - {{item.endTime}}</text>
          </view>
          <view class="collection-card-frequency">
            <uni-icon name="chart-trending-o" size="28" type="vant" color="#969799" />
            <text>{{frequencyLabel}}: {{item.usageCount}} 次</text>
          </view>
        </view>
        <view class="collection-card-right">
          <view class="collection-card-actions">
            <van-button
              type="primary"
              size="small"
              round
              class="action-btn"
              bind:tap="onSelectTimeSlot"
              data-id="{{item.id}}"
              data-name="{{item.name}}"
              data-start-time="{{item.startTime}}"
              data-end-time="{{item.endTime}}"
              data-usage-count="{{item.usageCount}}"
            >
              {{selectText}}
            </van-button>
            <view
              class="unfavorite-btn"
              bind:tap="onUnfavoriteTimeSlot"
              data-id="{{item.id}}"
              data-name="{{item.name}}"
            >
              <uni-icon name="star" size="36" type="vant" color="#969799" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <uni-icon name="star-o" size="120" type="vant" color="#dcdee0" />
      <view class="empty-text">{{emptyTimeSlotHint}}</view>
    </view>
  </view>
</view>
