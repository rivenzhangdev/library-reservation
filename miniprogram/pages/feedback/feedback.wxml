<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{true}}" />
</page-meta>

<view class="page-container {{languageClass}}">
  <view class="tab-container">
    <view
      class="tab-item {{currentTab === 'submit' ? 'active' : ''}}"
      bind:tap="onTabTap"
      data-tab="submit"
    >
      <text class="tab-text">{{submitTabText}}</text>
    </view>
    <view
      class="tab-item {{currentTab === 'records' ? 'active' : ''}}"
      bind:tap="onTabTap"
      data-tab="records"
    >
      <text class="tab-text">{{recordsTabText}}</text>
    </view>
  </view>

  <view wx:if="{{currentTab === 'submit'}}" class="submit-feedback">
    <view class="form-section">
      <view class="section-title">
        <text>{{typeTitle}}</text>
        <text class="required">*</text>
      </view>
      <view class="feedback-types">
        <view
          wx:for="{{feedbackTypes}}"
          wx:key="id"
          class="type-item {{selectedType === item.id ? 'active' : ''}}"
          bind:tap="onTypeTap"
          data-id="{{item.id}}"
        >
          <text class="type-text">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">
        <text>{{titleLabel}}</text>
        <text class="required">*</text>
      </view>
      <van-field
        value="{{title}}"
        placeholder="{{titlePlaceholder}}"
        maxlength="50"
        clearable
        bind:change="onTitleChange"
      />
    </view>

    <view class="form-section">
      <view class="section-title">
        <text>{{descriptionLabel}}</text>
        <text class="required">*</text>
      </view>
      <van-field
        value="{{description}}"
        type="textarea"
        placeholder="{{descriptionPlaceholder}}"
        maxlength="500"
        rows="5"
        show-word-limit
        bind:change="onDescriptionChange"
      />
    </view>

    <view class="form-section">
      <view class="section-title">
        <text>{{urgencyLabel}}</text>
      </view>
      <view class="urgency-levels">
        <view
          wx:for="{{urgencyLevels}}"
          wx:key="id"
          class="urgency-item {{selectedUrgency === item.id ? 'active' : ''}}"
          bind:tap="onUrgencyTap"
          data-id="{{item.id}}"
        >
          <uni-icon type="vant" name="{{item.icon}}" size="30" color="{{item.color}}" />
          <text class="urgency-text">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">
        <text>{{imageLabel}}</text>
        <text class="optional">{{imageOptionalText}}</text>
      </view>
      <view class="image-upload-area">
        <scroll-view class="image-upload-row" scroll-x="true" show-scrollbar="false">
          <view
            wx:if="{{uploadedImages.length < maxImageCount}}"
            class="image-upload-btn"
            bind:tap="onImageUpload"
          >
            <uni-icon type="vant" name="photograph" size="40" color="#999" />
            <text class="upload-text">{{imageUploadText}}</text>
          </view>
          <view
            wx:for="{{uploadedImages}}"
            wx:key="index"
            class="image-item"
            bind:tap="onImagePreview"
            data-index="{{index}}"
          >
            <image src="{{item}}" mode="aspectFill" class="image-thumb" />
            <view class="image-delete" catch:tap="onImageDelete" data-index="{{index}}">
              <uni-icon type="vant" name="close" size="24" color="#fff" />
            </view>
          </view>
        </scroll-view>
        <text class="upload-count">{{uploadedImages.length}}/{{maxImageCount}}</text>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">
        <text>{{contactLabel}}</text>
        <text class="optional">{{contactOptionalText}}</text>
      </view>
      <van-field
        value="{{contact}}"
        placeholder="{{contactPlaceholder}}"
        maxlength="50"
        clearable
        bind:change="onContactChange"
      />
    </view>

    <view class="submit-actions">
      <van-button type="primary" block round bind:click="onSubmitTap">
        {{submitButtonText}}
      </van-button>
    </view>
  </view>

  <view wx:if="{{currentTab === 'records'}}" class="feedback-records">
    <view wx:if="{{feedbackRecords.length > 0}}">
      <view
        wx:for="{{feedbackRecords}}"
        wx:key="id"
        class="record-item"
        bind:tap="onRecordTap"
        data-id="{{item.id}}"
      >
        <view class="record-header">
          <view class="record-title-wrapper">
            <view class="record-title-row">
              <text class="record-title">{{item.title}}</text>
              <van-tag type="{{item.statusStyle}}" round size="medium">{{item.statusText}}</van-tag>
            </view>
            <view class="record-meta">
              <text class="meta-type">{{item.typeName}}</text>
              <text class="meta-dot">·</text>
              <text class="meta-date">{{item.createTime}}</text>
            </view>
          </view>
        </view>
        <view class="record-details">
          <view class="detail-row">
            <uni-icon type="vant" name="label-o" size="24" color="#999" />
            <text class="detail-label">{{detailTypeText}}：</text>
            <text class="detail-text">{{item.typeName}}</text>
        </view>
          <view class="detail-row">
            <uni-icon type="vant" name="clock-o" size="24" color="#999" />
            <text class="detail-label">{{detailSubmitTimeText}}：</text>
            <text class="detail-text">{{item.createTime}}</text>
          </view>
          <view class="detail-row">
            <uni-icon type="vant" name="flag-o" size="24" color="#999" />
            <text class="detail-label">{{detailUrgencyText}}：</text>
            <text class="detail-text urgency-{{item.urgencyStyle}}"
              >{{item.urgencyName || '-'}}</text
            >
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state">
      <text class="empty-text">{{emptyText}}</text>
    </view>
  </view>
</view>
