<page-meta>
  <navigation-bar title="{{pageTitle}}" back="{{true}}" />
</page-meta>

<view class="page-container {{languageClass}}">
  <view class="credit-hero">
    <view class="hero-top-row">
      <van-tag type="primary" plain size="large">{{trustTag}}</van-tag>
      <text class="hero-hint">{{summaryHint}}</text>
    </view>

    <view class="hero-score-wrapper">
      <view>
        <text class="hero-score">{{creditScore}}</text>
        <text class="hero-score-label">{{scoreTip}}</text>
      </view>
      <view class="hero-status-card">
        <view class="hero-status-left">
          <view class="hero-status-icon">
            <uni-icon type="vant" name="star" size="32" color="#ffffff" />
          </view>
          <view class="hero-status-texts">
            <text class="hero-status-label">{{creditLevelLabel}}</text>
            <text class="hero-status-value">{{creditLevelText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="hero-progress">
      <view class="hero-progress-bar">
        <view class="hero-progress-fill" style="width: {{progressPercent}}%;" />
      </view>
      <text class="hero-progress-text">{{nextLevelHint}}</text>
    </view>
  </view>

  <view class="info-cards">
    <view class="info-card">
      <view class="info-card-head">
        <view class="info-card-icon info-card-icon--positive">
          <uni-icon type="vant" name="star" size="28" color="#ffffff" />
        </view>
        <text class="info-card-title">{{benefitTitle}}</text>
      </view>
      <text class="info-card-text">{{benefitDesc}}</text>
    </view>
    <view class="info-card">
      <view class="info-card-head">
        <view class="info-card-icon info-card-icon--secondary">
          <uni-icon type="vant" name="clock-o" size="28" color="#ffffff" />
        </view>
        <text class="info-card-title">{{ruleTitle}}</text>
      </view>
      <text class="info-card-text">{{ruleDesc}}</text>
    </view>
  </view>

  <view class="records-card">
    <view class="records-header">
      <view>
        <text class="section-title">{{recordsTitle}}</text>
        <text class="section-hint">{{summaryHint}}</text>
      </view>
    </view>

    <view wx:if="{{records.length === 0 && !recordsLoading}}" class="empty-state">
      <uni-icon type="vant" name="file-empty-o" size="72" color="#d0d7de" />
      <text class="empty-text">{{emptyText}}</text>
    </view>

    <block wx:for="{{records}}" wx:key="id">
      <view class="record-item">
        <view class="record-row">
          <text class="record-type">{{item.typeLabel}}</text>
          <text class="record-points {{item.pointsClass}}">{{item.pointsLabel}}</text>
        </view>
        <text class="record-reason">{{item.reason}}</text>
        <text class="record-date">{{item.dateText}}</text>
      </view>
    </block>

    <view wx:if="{{recordsLoading}}" class="empty-state">
      <uni-icon type="vant" name="loading" size="72" color="#409eff" />
      <text class="empty-text">{{loadingText}}</text>
    </view>
  </view>
</view>
