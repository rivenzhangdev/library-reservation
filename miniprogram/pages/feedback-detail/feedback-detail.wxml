<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{true}}" />
</page-meta>

<view class="page-container {{languageClass}}">
  <view class="feedback-info" wx:if="{{feedbackInfo.id}}">
    <view class="info-header">
      <view class="info-title-wrapper">
        <text class="info-title">{{feedbackInfo.title}}</text>
        <view class="info-meta">
          <text class="meta-type">{{feedbackInfo.typeName}}</text>
          <text class="meta-dot">/</text>
          <text class="meta-date">{{feedbackInfo.createTime}}</text>
        </view>
      </view>
      <van-tag type="{{feedbackInfo.statusStyle}}" size="medium"
        >{{feedbackInfo.statusText}}</van-tag
      >
    </view>

    <view class="status-hint" wx:if="{{feedbackInfo.statusHint}}">
      <text class="status-hint-text">{{feedbackInfo.statusHint}}</text>
    </view>

    <view class="info-details">
      <view class="detail-row">
        <uni-icon type="vant" name="label-o" size="28" color="#999" />
        <text class="detail-label">{{t('feedback.detail.type')}}:</text>
        <text class="detail-text">{{feedbackInfo.typeName}}</text>
      </view>
      <view class="detail-row">
        <uni-icon type="vant" name="clock-o" size="28" color="#999" />
        <text class="detail-label">{{t('feedback.detail.submitTime')}}:</text>
        <text class="detail-text">{{feedbackInfo.createTime}}</text>
      </view>
      <view class="detail-row">
        <uni-icon type="vant" name="flag-o" size="28" color="#999" />
        <text class="detail-label">{{t('feedback.detail.urgency')}}:</text>
        <text class="detail-text urgency-{{feedbackInfo.urgencyStyle}}"
          >{{feedbackInfo.urgencyName || '-'}}</text
        >
      </view>
      <view wx:if="{{feedbackInfo.contact}}" class="detail-row">
        <uni-icon type="vant" name="phone" size="28" color="#999" />
        <text class="detail-label">{{t('feedback.detail.contact')}}:</text>
        <text class="detail-text">{{feedbackInfo.contact}}</text>
      </view>
    </view>

    <view class="info-content">
      <text class="content-label">{{t('feedback.detail.content')}}</text>
      <text class="content-text">{{feedbackInfo.description}}</text>
    </view>

    <view wx:if="{{feedbackInfo.images && feedbackInfo.images.length > 0}}" class="info-content">
      <text class="content-label">{{t('feedback.detail.images')}}</text>
      <view
        class="info-images info-images-{{feedbackInfo.images.length > 3 ? 3 : feedbackInfo.images.length}}"
      >
        <view
          class="image-wrapper"
          wx:for="{{feedbackInfo.images}}"
          wx:key="*this"
          wx:for-index="index"
          wx:if="{{index < 3}}"
        >
          <image
            src="{{feedbackInfo.images[index]}}"
            mode="aspectFill"
            class="content-image content-image-{{feedbackInfo.images.length > 3 ? 3 : feedbackInfo.images.length}}"
            bind:tap="onImagePreview"
            data-index="{{index}}"
          />
          <view
            wx:if="{{index === 2 && feedbackInfo.images.length > 3}}"
            class="content-image-mask"
            bind:tap="onImagePreview"
            data-index="2"
          >
            <text class="image-mask-text">+{{feedbackInfo.images.length - 3}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="process-section" wx:if="{{feedbackInfo.id}}">
      <view class="section-title">{{t('feedback.detail.timelineTitle')}}</view>
      <view class="process-overview">
        <view class="overview-card">
          <text class="overview-label">{{t('feedback.detail.currentStatus')}}</text>
          <text class="overview-value">{{feedbackInfo.statusText}}</text>
        </view>
        <view class="overview-card">
          <text class="overview-label">{{t('feedback.detail.submitTime')}}</text>
          <text class="overview-value overview-value--sm">{{feedbackInfo.createTime}}</text>
        </view>
        <view class="overview-card">
          <text class="overview-label">{{t('feedback.detail.latestUpdate')}}</text>
          <text class="overview-value overview-value--sm"
            >{{feedbackInfo.latestUpdateTime || '-'}}</text
          >
        </view>
      </view>

      <view class="official-summary" wx:if="{{feedbackInfo.latestOfficialReply}}">
        <view class="official-summary__header">
          <uni-icon type="vant" name="service-o" size="26" color="#1677b3" />
          <text class="official-summary__title">{{t('feedback.detail.officialReplyTitle')}}</text>
        </view>
        <text class="official-summary__text">{{feedbackInfo.latestOfficialReply}}</text>
      </view>

      <view class="updates-list">
        <block wx:for="{{feedbackInfo.updates}}" wx:key="id">
          <view class="update-card update-card--{{item.tone}}">
            <view class="update-header">
              <view class="update-header__main">
                <text class="update-title">{{item.title}}</text>
                <text class="update-role" wx:if="{{item.userRole}}">{{item.userRole}}</text>
              </view>
              <text class="update-time">{{item.time}}</text>
            </view>
            <view class="update-meta" wx:if="{{item.userName}}">{{item.userName}}</view>
            <text class="update-content">{{item.content || '-'}}</text>
          </view>
        </block>
        <view
          wx:if="{{!feedbackInfo.updates || !feedbackInfo.updates.length}}"
          class="empty-process"
        >
          <text class="empty-process-text">{{t('feedback.detail.noRecords')}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!feedbackInfo.id}}" class="empty-state">
    <uni-icon type="vant" name="underway-o" size="120" color="#ddd" />
    <text class="empty-text">{{t('common.empty.notFound')}}</text>
  </view>
</view>
