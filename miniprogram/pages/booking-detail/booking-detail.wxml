<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{true}}" />
</page-meta>

<view class="page-container">
  <view wx:if="{{booking}}" class="hero-card">
    <view class="hero-card-row">
      <view class="hero-text">
        <text class="hero-title">{{booking.seatName}}</text>
        <text class="hero-subtitle">{{booking.description || t('common.empty.noDescription')}}</text>
      </view>
      <view class="hero-badges">
        <van-tag type="{{booking.statusType}}" size="large" class="hero-status-tag"
          >{{booking.statusText}}</van-tag
        >
      </view>
    </view>
    <view class="hero-meta-row">
      <view class="hero-meta-item">
        <text class="hero-meta-label">{{t('myReservation.field.bookingDate')}}</text>
        <text class="hero-meta-value">{{booking.date}}</text>
      </view>
      <view class="hero-meta-item">
        <text class="hero-meta-label">{{t('myReservation.field.bookingTime')}}</text>
        <text class="hero-meta-value">{{booking.startTime}} - {{booking.endTime}}</text>
      </view>
    </view>

    <view class="hero-attr-row">
      <view class="hero-attr-item">
        <text class="hero-attr-label">{{t('myReservation.field.region')}}</text>
        <text class="hero-attr-value">{{booking.regionLabel}}</text>
      </view>
      <view class="hero-attr-item">
        <text class="hero-attr-label">{{t('myReservation.field.seatType')}}</text>
        <text class="hero-attr-value">{{booking.seatType}}</text>
      </view>
      <view wx:if="{{booking.signInTime}}" class="hero-attr-item">
        <text class="hero-attr-label">{{t('myReservation.field.signInTime')}}</text>
        <text class="hero-attr-value">{{booking.signInTime}}</text>
      </view>
    </view>

    <view class="hero-actions">
      <van-button wx:if="{{booking.canRenew}}" type="primary" round bind:tap="onRenew">{{t('myReservation.action.renew')}}</van-button>
      <van-button wx:if="{{booking.canCancel}}" plain round bind:tap="onCancel">{{t('myReservation.action.cancel')}}</van-button>
    </view>
  </view>

  <view wx:if="{{!booking}}" class="empty-state">
    <uni-icon type="vant" name="search" size="72" color="#d0d7de" />
    <text class="empty-text">{{t('common.empty.notFound')}}</text>
  </view>
</view>
