<page-meta>
  <navigation-bar title="{{pageTitle}}" back="true" />
</page-meta>

<view class="page">
  <view class="section">
    <view class="list">
      <block wx:for="{{envs}}" wx:key="key">
        <view class="item" data-key="{{item.key}}" bindtap="onEnvTap">
          <view class="left">
            <text class="label">{{item.label}}</text>
            <text class="base">{{item.baseUrl}}</text>
          </view>
          <view class="right">
            <text wx:if="{{currentBase === item.baseUrl}}" class="current">{{'当前'}}</text>
            <text wx:else class="select">{{'选择'}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
