<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{true}}" />
</page-meta>

<view class="page-container {{languageClass}}">
  <view class="profile-card">
    <view class="card-header">
      <button
        class="avatar-shell"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseAvatar"
        hover-class="none"
      >
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <uni-icon type="vant" name="user-o" size="80" color="#ffffff" />
        </view>
        <view class="avatar-upload-overlay">
          <uni-icon type="vant" name="plus" size="34" color="#ffffff" />
        </view>
      </button>
      <view class="user-info">
        <text class="user-name">{{userName}}</text>
        <text wx:if="{{isAdmin}}" class="user-role">{{userRole}}</text>
      </view>
    </view>

    <view class="profile-details">
      <view class="detail-row">
        <text class="detail-label">{{creditScoreLabel}}</text>
        <text class="detail-value">{{creditScore}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">{{registerDateLabel}}</text>
        <text class="detail-value">{{registerDate}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">{{bookingCountLabel}}</text>
        <text class="detail-value">{{bookingCount}}</text>
      </view>
    </view>

    <view class="profile-edit-card">
      <van-field
        label="{{usernameLabel}}"
        value="{{usernameField}}"
        placeholder="{{usernamePlaceholder}}"
        bind:change="onUsernameChange"
        input-align="right"
      />
      <van-field
        label="{{emailLabel}}"
        value="{{emailField}}"
        placeholder="{{emailPlaceholder}}"
        type="email"
        bind:change="onEmailChange"
        input-align="right"
      />
      <van-field
        label="{{phoneLabel}}"
        value="{{phoneField}}"
        placeholder="{{phonePlaceholder}}"
        type="number"
        bind:change="onPhoneChange"
        input-align="right"
        disabled="{{phoneBound}}"
      />
      <view wx:if="{{phoneBound}}" class="phone-bound-hint">
        <view class="phone-bound-hint-desc">
          <uni-icon type="vant" name="info-o" size="24" color="#64748b" />
          <text class="tip-text">{{phoneChangeHint}}</text>
        </view>
        <van-button
          class="change-phone-button"
          type="{{showPhoneRequestForm ? 'warning' : 'info'}}"
          plain="{{!showPhoneRequestForm}}"
          bind:tap="onRequestPhoneChangeTap"
        >
          {{showPhoneRequestForm ? cancelPhoneChangeText : phoneChangeText}}
        </van-button>
      </view>
      <van-button
        custom-class="save-profile-button"
        type="primary"
        loading="{{savingProfile}}"
        bind:tap="onSaveProfile"
      >
        {{saveProfileText}}
      </van-button>
    </view>

    <view wx:if="{{showPhoneRequestForm}}" class="bind-form">
      <van-field
        value="{{requestPhone}}"
        label="{{phoneChangeNewLabel}}"
        placeholder="{{phoneChangeNewPlaceholder}}"
        type="number"
        bind:change="onRequestPhoneFieldChange"
        input-align="right"
      />
      <van-field
        value="{{requestPhoneReason}}"
        label="{{changeReasonLabel}}"
        placeholder="{{changeReasonPlaceholder}}"
        type="textarea"
        autosize
        bind:change="onRequestPhoneReasonChange"
      />
      <van-button
        custom-class="bind-button"
        type="primary"
        loading="{{requestingChange}}"
        bind:tap="onSavePhoneChangeRequest"
      >
        {{savePhoneChangeText}}
      </van-button>
    </view>

    <text class="school-title">{{studentProfileTitle}}</text>
    <view class="school-card">
      <view class="school-info-rows">
        <van-field
          class="school-info-field"
          label="{{collegeLabel}}"
          value="{{isStudentBound ? (studentCollege || '-') : '-'}}"
          disabled
          input-align="right"
        />
        <van-field
          class="school-info-field"
          label="{{majorLabel}}"
          value="{{isStudentBound ? (studentMajor || '-') : '-'}}"
          disabled
          input-align="right"
        />
        <van-field
          class="school-info-field"
          label="{{gradeLabel}}"
          value="{{isStudentBound ? (studentGrade || '-') : '-'}}"
          disabled
          input-align="right"
        />
        <van-field
          class="school-info-field"
          label="{{nameLabel}}"
          value="{{studentRealName || '-'}}"
          disabled
          input-align="right"
        />
        <van-field
          class="school-info-field"
          label="{{studentIdLabel}}"
          value="{{studentId}}"
          placeholder="{{studentIdPlaceholder}}"
          disabled
          input-align="right"
        />
      </view>
      <view class="school-actions">
        <van-button
          wx:if="{{!isStudentBound && !pendingChangeRequest}}"
          custom-class="detail-action"
          type="primary"
          bind:tap="onBindStudentIdTap"
        >
          {{bindStudentIdText}}
        </van-button>
        <van-button
          wx:elif="{{isStudentBound && !pendingChangeRequest}}"
          custom-class="detail-action"
          type="{{showRequestForm ? 'warning' : 'info'}}"
          plain="{{!showRequestForm}}"
          bind:tap="onRequestChangeTap"
        >
          {{showRequestForm ? cancelStudentIdChangeText : requestChangeText}}
        </van-button>
      </view>
      <!-- 待审核改绑状态提示 -->
      <view wx:if="{{pendingChangeRequest}}" class="pending-review-banner">
        <uni-icon type="vant" name="clock-o" size="28" color="#f59e0b" />
        <text class="pending-review-text"
          >学号改绑申请审核中，目标学号：{{maskedTargetStudentId}}（{{maskedTargetName}}）</text
        >
      </view>
      <view wx:elif="{{isStudentBound}}" class="student-change-tip">
        <uni-icon type="vant" name="info-o" size="22" color="#94a3b8" />
        <view class="student-change-tip-content">
          <text class="tip-text">{{requestChangeHint}}</text>
          <text class="tip-text tip-text-secondary">{{requestChangeVerifyHint}}</text>
          <text class="tip-text tip-text-warning">{{requestChangeMissingNameHint}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{showBindForm}}" class="bind-form">
      <van-field
        value="{{bindStudentId}}"
        label="{{studentIdLabel}}"
        placeholder="{{studentIdPlaceholder}}"
        bind:change="onBindStudentIdChange"
        bind:blur="onBindStudentIdBlur"
      />
      <van-field
        wx:if="{{bindPrecheckStatus === 'blocked'}}"
        value="{{bindName}}"
        label="{{nameLabel}}"
        placeholder="{{nameLabel}}"
        bind:change="onBindNameChange"
      />
      <view wx:if="{{bindPrecheckMessage}}" class="precheck-box precheck-{{bindPrecheckStatus}}">
        <text class="precheck-message">{{bindPrecheckMessage}}</text>
        <text wx:if="{{bindPrecheckStatus === 'ok'}}" class="precheck-extra"
          >{{bindPrecheckMatchedHint}}</text
        >
      </view>
      <van-button
        custom-class="bind-button"
        type="primary"
        loading="{{binding || precheckingStudentId}}"
        bind:tap="onSaveBinding"
      >
        {{bindSubmitText}}
      </van-button>
      <van-button
        wx:if="{{bindPrecheckStatus === 'blocked' && (bindPrecheckReasonCode === 'ALREADY_BOUND' || bindPrecheckReasonCode === 'NOT_FOUND')}}"
        custom-class="bind-button appeal-button"
        type="default"
        plain
        bind:tap="onSubmitStudentIdAppeal"
      >
        {{submitAppealText}}
      </van-button>

      <view wx:if="{{appealFeedbackText}}" class="precheck-box precheck-{{appealFeedbackType}}">
        <text class="precheck-message">{{appealFeedbackText}}</text>
      </view>
    </view>

    <view wx:if="{{showRequestForm}}" class="bind-form">
      <van-field
        value="{{requestStudentId}}"
        label="{{studentIdLabel}}"
        placeholder="{{studentIdPlaceholder}}"
        bind:change="onRequestStudentIdChange"
      />
      <van-button
        custom-class="bind-button"
        type="primary"
        loading="{{requestingChange}}"
        bind:tap="onSaveChangeRequest"
      >
        {{requestChangeText}}
      </van-button>
    </view>
  </view>
</view>

<!-- 原因输入弹窗（申诉/改绑共用） -->
<van-popup
  show="{{showReasonModal !== ''}}"
  position="center"
  round
  bind:close="onCloseReasonModal"
  custom-class="reason-modal-popup"
>
  <view class="reason-modal-head">
    <view class="reason-modal-title">
      {{showReasonModal === 'appeal' ? studentIdAppealTitle : changeReasonLabel}}
    </view>
  </view>
  <view class="reason-modal-hint">
    {{showReasonModal === 'appeal' ? studentIdAppealPlaceholder : changeReasonPlaceholder}}
  </view>
  <!-- Appeal reason textarea -->
  <van-field
    wx:if="{{showReasonModal === 'appeal'}}"
    custom-class="reason-modal-field"
    value="{{studentIdAppealReason}}"
    placeholder="{{changeReasonPlaceholder}}"
    type="textarea"
    autosize
    maxlength="500"
    show-word-limit
    border="{{false}}"
    bind:change="onStudentIdAppealReasonChange"
  />
  <!-- Change reason textarea -->
  <van-field
    wx:elif="{{showReasonModal === 'change'}}"
    custom-class="reason-modal-field"
    value="{{requestReason}}"
    placeholder="{{changeReasonPlaceholder}}"
    type="textarea"
    autosize
    maxlength="500"
    show-word-limit
    border="{{false}}"
    bind:change="onRequestReasonChange"
  />
  <view class="reason-modal-actions">
    <van-button
      type="primary"
      size="small"
      custom-class="reason-modal-btn"
      loading="{{submitStudentIdAppealLoading || requestingChange}}"
      bind:tap="onConfirmReasonModal"
    >
      确认提交
    </van-button>
    <van-button
      type="default"
      size="small"
      custom-class="reason-modal-btn reason-modal-btn-cancel"
      bind:tap="onCloseReasonModal"
    >
      取消
    </van-button>
  </view>
</van-popup>

<van-popup
  show="{{showBindNameVerifyPopup}}"
  position="center"
  close-on-click-overlay="{{false}}"
  bind:close="onCloseBindNameVerifyPopup"
  custom-class="name-verify-popup"
>
  <view class="name-verify-title">{{bindNameVerifyTitle}}</view>
  <view class="name-verify-hint">{{bindNameVerifyHint}}</view>

  <view class="name-verify-line">
    <text class="name-verify-fixed" wx:if="{{bindNameVerifyPrefix}}">{{bindNameVerifyPrefix}}</text>
    <view class="name-verify-input-list">
      <input
        wx:for="{{bindNamePartChars}}"
        wx:key="index"
        class="name-verify-input"
        data-index="{{index}}"
        value="{{item}}"
        type="text"
        maxlength="1"
        focus="{{bindNameVerifyFocusIndex === index}}"
        bindfocus="onBindNamePartCharFocus"
        bindinput="onBindNamePartCharInput"
      />
    </view>
  </view>

  <view class="name-verify-actions">
    <van-button
      type="primary"
      custom-class="name-verify-btn"
      loading="{{binding}}"
      bind:tap="onConfirmBindNameVerify"
    >
      {{bindNameVerifyConfirmText}}
    </van-button>
    <van-button
      plain
      type="default"
      custom-class="name-verify-btn name-verify-btn-cancel"
      bind:tap="onCloseBindNameVerifyPopup"
    >
      {{bindNameVerifyCancelText}}
    </van-button>
  </view>
</van-popup>
