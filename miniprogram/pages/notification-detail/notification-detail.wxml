<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{true}}" />
</page-meta>

<view class="page-container {{languageClass}}">
  <view wx:if="{{notification}}" class="hero-card">
    <view class="hero-headline">
      <text class="hero-title">{{notification.title}}</text>
      <text class="hero-subtitle">{{notification.content}}</text>
    </view>
    <view class="hero-tags">
      <van-tag type="primary" size="large">{{notification.typeText}}</van-tag>
      <van-tag
        size="medium"
        plain
        type="{{notification.isRead ? 'success' : 'warning'}}"
      >
        {{notification.isReadText}}
      </van-tag>
    </view>
  </view>

  <view wx:if="{{notification}}" class="section-card">
    <view class="section-title">{{basicInfoLabel}}</view>
    <view class="info-row">
      <text class="label">{{timeLabel}}</text>
      <text class="value">{{notification.time}}</text>
    </view>
    <view class="info-row">
      <text class="label">{{publisherLabel}}</text>
      <text class="value">{{notification.publisherName || '-'}}</text>
    </view>
    <view wx:if="{{notification.updatedByName}}" class="info-row">
      <text class="label">{{updatedByLabel}}</text>
      <text class="value">{{notification.updatedByName}}</text>
    </view>
  </view>

  <view wx:if="{{notification.extraInfoRows.length}}" class="section-card">
    <view class="section-title">{{extraInfoLabel}}</view>
    <view
      wx:for="{{notification.extraInfoRows}}"
      wx:key="label"
      class="info-row"
    >
      <text class="label">{{item.label}}</text>
      <text class="value">{{item.value}}</text>
    </view>
  </view>

  <view wx:if="{{notification}}" class="section-card">
    <view class="section-title">{{contentLabel}}</view>
    <text class="description-text">{{notification.content}}</text>
  </view>

  <view wx:if="{{loading}}" class="empty-state">
    <uni-icon type="vant" name="loading" size="72" color="#409eff" />
    <text class="empty-text">{{loadingText}}</text>
  </view>

  <view wx:if="{{!loading && !notification}}" class="empty-state">
    <uni-icon type="vant" name="search" size="72" color="#d0d7de" />
    <text class="empty-text">{{emptyText}}</text>
  </view>
</view>