<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{true}}" />
</page-meta>

<view class="page-container {{languageClass}}">
  <status-filter
    status-list="{{statusList}}"
    current-status="{{currentStatus}}"
    container-style="margin: 0 -20rpx;"
    bind:status-change="onStatusChange"
  />

  <view class="activity-list">
    <view wx:for="{{filteredActivities}}" wx:key="id" class="activity-item">
      <view class="activity-image-wrapper">
        <image
          wx:if="{{item.image}}"
          class="activity-image"
          src="{{item.image}}"
          mode="aspectFill"
        />
        <view wx:else class="activity-image activity-image--placeholder">
          <uni-icon type="vant" name="notes-o" size="64" color="#ffffff" />
        </view>

        <view
          wx:for="{{item.tags}}"
          wx:key="index"
          wx:for-item="tag"
          class="activity-tag tag-{{tag.position}}"
        >
          <van-tag type="{{tag.type || 'default'}}" size="small">{{tag.text}}</van-tag>
        </view>
      </view>

      <view class="activity-content">
        <view class="activity-title">{{item.title}}</view>

        <view class="activity-info-row">
          <view class="info-item">
            <uni-icon type="vant" name="calendar-o" size="24" color="#64748b" />
            <text class="info-text">{{item.timeRange}}</text>
          </view>
          <view class="info-item">
            <uni-icon type="vant" name="location-o" size="24" color="#64748b" />
            <text class="info-text">{{item.location}}</text>
          </view>
          <view class="info-item">
            <uni-icon type="vant" name="friends-o" size="24" color="#64748b" />
            <text class="info-text"
              >{{item.participants}}/{{item.maxParticipants}} {{participantsText}}</text
            >
          </view>
        </view>

        <view class="activity-description">{{item.description}}</view>

        <view class="publisher-row">
          <text class="publisher-label">{{publisherLabel}}</text>
          <text class="publisher-value">{{item.publisher}}</text>
        </view>

        <view class="activity-actions">
          <block wx:for="{{item.buttons}}" wx:key="action" wx:for-item="btn">
            <van-button
              class="action-btn {{btn.type}}"
              size="small"
              plain="{{btn.type === ''}}"
              type="{{btn.type === 'primary' ? 'primary' : 'default'}}"
              bind:tap="onActionTap"
              data-action="{{btn.action}}"
              data-id="{{item.id}}"
              custom-style="width: 100%"
            >
              {{btn.text}}
            </van-button>
          </block>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{filteredActivities.length === 0}}" class="empty-state">
    <uni-icon name="gift-o" size="80" color="#dcdee0" type="vant" />
    <text class="empty-text">{{emptyHint}}</text>
  </view>

  <view class="list-footer" wx:if="{{filteredActivities.length > 0}}">
    <text wx:if="{{loadingMore}}" class="list-footer__text">{{loadingMoreText}}</text>
    <text wx:elif="{{!hasMore}}" class="list-footer__text">{{noMoreText}}</text>
  </view>
</view>
