<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{true}}" />
</page-meta>

<view class="page-container">
  <view wx:if="{{seat}}" class="hero-card">
    <view class="hero-top">
      <view>
        <view class="hero-title">{{seat.name}}</view>
        <view class="hero-subtitle">{{seat.description}}</view>
      </view>
      <view class="favorite-btn" bind:tap="onToggleFavorite">
        <uni-icon type="vant" name="{{isFavorite ? 'star' : 'star-o'}}" size="34" color="#ffb020" />
      </view>
    </view>

    <view class="meta-grid">
      <view class="meta-item">
        <text class="meta-label">{{t('common.field.floor')}}</text>
        <text class="meta-value">{{seat.floorName}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">{{t('common.field.zone')}}</text>
        <text class="meta-value">{{seat.zone}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">{{t('common.field.type')}}</text>
        <text class="meta-value">{{seat.typeText}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">{{t('common.field.date')}}</text>
        <text class="meta-value">{{currentDate}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{seat}}" class="section-card">
    <view class="section-title">{{t('common.field.facilities')}}</view>
    <view class="tag-row">
      <van-tag wx:for="{{seat.facilities}}" wx:key="*this" plain type="primary" class="tag-item"
        >{{item}}</van-tag
      >
      <text wx:if="{{!seat.facilities.length}}" class="empty-text"
        >{{t('common.empty.noDescription')}}</text
      >
    </view>
  </view>

  <view wx:if="{{seat}}" class="section-card">
    <view class="section-title">{{t('common.field.range')}}</view>
    <view class="slot-list">
      <view wx:for="{{timeSlots}}" wx:key="key" class="slot-item">
        <text class="slot-label">{{item.label}}</text>
        <van-tag type="{{item.type}}" size="medium">{{item.text}}</van-tag>
      </view>
    </view>
  </view>

  <view wx:if="{{seat}}" class="action-bar">
    <van-button type="primary" round block bind:tap="onReserve"
      >{{t('common.btn.reserve')}}</van-button
    >
  </view>

  <view wx:if="{{!seat}}" class="empty-state">
    <uni-icon type="vant" name="search" size="72" color="#d0d7de" />
    <text class="empty-text">{{t('common.empty.notFound')}}</text>
  </view>
</view>
