<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{true}}" />
</page-meta>

<view class="page-container {{languageClass}}">
  <view wx:if="{{seat}}" class="hero-card">
    <view class="hero-main">
      <text class="hero-title">{{seat.name}}</text>
      <text class="hero-subtitle">
        {{seat.floorName}}{{seat.zone ? ' · ' + seat.zone : ''}}{{seat.position ? ' · ' +
        seat.position : ''}}
      </text>
      <view class="hero-tags">
        <van-tag type="{{seat.statusTag}}" plain size="medium">{{seat.statusText}}</van-tag>
        <van-tag type="primary" plain size="medium">{{seat.typeLabel}}</van-tag>
        <van-tag wx:if="{{seat.isMine}}" type="success" plain size="medium"
          >{{mineTagText}}</van-tag
        >
      </view>
    </view>

    <view class="hero-actions">
      <view
        class="favorite-action {{favoriteActionActive ? 'active' : ''}}"
        bindtap="onToggleFavorite"
      >
        <uni-icon
          class="favorite-icon"
          type="vant"
          size="40"
          name="{{isFavorite ? 'heart' : 'heart-o'}}"
          color="{{isFavorite ? '#ef4444' : '#64748b'}}"
        />
        <text class="favorite-text">{{isFavorite ? unfavoriteText : favoriteText}}</text>
      </view>
      <van-button
        class="reserve-button"
        type="primary"
        size="small"
        round
        bind:tap="onReserve"
        disabled="{{!isSeatAvailable}}"
      >
        {{reserveButtonText}}
      </van-button>
    </view>
    <text wx:if="{{reserveNoticeText}}" class="reserve-notice">{{reserveNoticeText}}</text>
  </view>

  <view wx:if="{{seat}}" class="section-card">
    <view class="section-title">{{sectionBasicLabel}}</view>
    <view class="info-row">
      <text class="label">{{floorLabel}}</text>
      <text class="value">{{seat.floorName || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="label">{{zoneLabel}}</text>
      <text class="value">{{seat.zone || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="label">{{positionLabel}}</text>
      <text class="value">{{seat.position || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="label">{{typeLabel}}</text>
      <text class="value">{{seat.typeLabel}}</text>
    </view>
    <view class="info-row info-row--multi">
      <text class="label">{{facilitiesLabel}}</text>
      <view class="facilities-list">
        <van-tag
          wx:for="{{seat.facilities}}"
          wx:key="*this"
          plain
          type="default"
          size="small"
          class="facility-tag"
        >
          {{item}}
        </van-tag>
        <text wx:if="{{seat.facilities.length === 0}}" class="empty-facility"
          >{{commonNoDescription}}</text
        >
      </view>
    </view>
    <view class="info-row">
      <text class="label">{{statusLabel}}</text>
      <text class="value">{{seat.statusText}}</text>
    </view>
  </view>

  <view wx:if="{{seat}}" class="section-card">
    <view class="section-title">{{sectionAvailabilityLabel}}</view>
    <view class="slot-grid">
      <view wx:for="{{slotStatusList}}" wx:key="value" class="slot-item">
        <text class="slot-label">{{item.label}}</text>
        <view class="slot-tag">
          <van-tag type="{{item.tagType}}" plain size="small">{{item.statusText}}</van-tag>
        </view>
        <text class="slot-range">{{item.range}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{seat}}" class="section-card">
    <view class="section-title">{{sectionBookingLabel}}</view>
    <text wx:if="{{todayBookingSummary}}" class="booking-summary">{{todayBookingSummary}}</text>
    <view wx:if="{{bookings.length > 0}}">
      <view wx:for="{{bookings}}" wx:key="id" class="booking-item">
        <text class="booking-time">{{item.timeRange}}</text>
        <text class="booking-label">{{item.label}}</text>
      </view>
    </view>
    <view wx:else class="empty-note">
      <text>{{noBookingsText}}</text>
    </view>
  </view>

  <view wx:if="{{seat}}" class="section-card">
    <view class="section-title">{{descriptionLabel}}</view>
    <text class="description-text">{{seat.description || commonNoDescription}}</text>
  </view>

  <view wx:if="{{!seat}}" class="empty-state">
    <uni-icon type="vant" name="search" size="72" color="#d0d7de" />
    <text class="empty-text">{{commonNoDescription}}</text>
  </view>
</view>
