<!-- 预约页面 -->
<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{false}}" />
</page-meta>

<view class="page-container {{languageClass}}">
  <!-- 楼层选择区域 -->
  <view class="floor-section">
    <view class="section-title">{{floorSelectText}}</view>
    <scroll-view class="floor-tags" scroll-x enable-flex>
      <view
        wx:for="{{floors}}"
        wx:key="id"
        class="floor-tag {{currentFloor === item.id ? 'active' : ''}}"
        bind:tap="onFloorTap"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </scroll-view>
  </view>

  <!-- 时间选择模块（移到最上方） -->
  <view class="time-selection-section">
    <view class="section-title">{{timeSelectText}}</view>

    <!-- 日期选择 -->
    <view class="date-picker">
      <van-cell-group>
        <van-field
          readonly
          value="{{selectedDate}}"
          placeholder="{{t('reservation.time.date.placeholder')}}"
          bind:click="onDateClick"
          is-link
          right-icon="calendar-o"
        />
      </van-cell-group>
    </view>

    <!-- 时段选择 -->
    <view class="time-period-section">
      <view class="section-subtitle">{{timePeriodText}}</view>
      <view class="time-period-options">
        <block wx:for="{{timePeriods}}" wx:key="value">
          <view
            class="time-period-option {{currentTimePeriod === item.value ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}"
            bind:tap="onTimePeriodTap"
            data-value="{{item.value}}"
          >
            <view class="time-period-label">{{item.label}}</view>
            <view class="time-period-range">{{item.start}} - {{item.end}}</view>
          </view>
        </block>
      </view>

      <!-- 自定义时间段入口 -->
      <view class="custom-time-toggle" wx:if="{{!showCustomTime}}" bind:tap="toggleCustomTime">
        <uni-icon type="vant" name="edit" size="24" color="var(--common-primary-color)" />
        <text class="custom-time-text">{{customTimeConfirmText}}</text>
      </view>

      <!-- 自定义时间段面板 -->
      <view class="custom-time-panel" wx:if="{{showCustomTime}}">
        <view class="custom-time-inputs">
          <view class="custom-time-input">
            <view class="custom-time-label">{{customTimeStartText}}</view>
            <view class="time-picker" bind:tap="onStartTimeClick">
              <view class="picker-display">
                <text>{{startTime}}</text>
                <uni-icon type="vant" name="clock-o" size="24" />
              </view>
            </view>
          </view>

          <view class="custom-time-input">
            <view class="custom-time-label">{{customTimeEndText}}</view>
            <view class="time-picker" bind:tap="onEndTimeClick">
              <view class="picker-display">
                <text>{{endTime}}</text>
                <uni-icon type="vant" name="clock-o" size="24" />
              </view>
            </view>
          </view>
        </view>

        <view class="custom-time-confirm" bind:tap="onConfirmCustomTime">
          {{customTimeConfirmText}}
        </view>
      </view>

      <van-popup
        show="{{showDatetimePicker}}"
        position="bottom"
        custom-style="height: 320px;"
        bind:close="onDatetimePickerCancel"
      >
        <van-datetime-picker
          type="{{datetimePickerType}}"
          value="{{datetimePickerValue}}"
          bind:confirm="onDatetimePickerConfirm"
          bind:cancel="onDatetimePickerCancel"
        />
      </van-popup>

      <!-- 取消自定义时间段 -->
      <view class="cancel-custom-time" wx:if="{{showCustomTime}}" bind:tap="toggleCustomTime">
        <uni-icon type="vant" name="delete-o" size="24" />
        <text class="cancel-custom-text">{{customTimeCancelText}}</text>
      </view>
    </view>

    <!-- 时长选择 -->
    <view class="duration-section">
      <view class="section-subtitle">{{timeDurationText}}</view>
      <view class="duration-options">
        <block wx:for="{{durations}}" wx:key="value">
          <view
            class="duration-option {{currentDuration === item.value ? 'active' : ''}}"
            bind:tap="onDurationTap"
            data-value="{{item.value}}"
          >
            {{item.label}}
          </view>
        </block>
      </view>
    </view>

    <!-- 当前预约时间显示 -->
    <view class="current-time-display">
      <text class="current-time-label">{{timeRangeLabelText}}</text>
      <text class="current-time-value">{{customTimePeriodText}}</text>
    </view>
  </view>

  <!-- 筛选按钮 -->
  <view class="filter-bar">
    <view class="filter-right">
      <van-search
        value="{{searchValue}}"
        shape="round"
        custom-class="search-box"
        placeholder="{{searchPlaceholderText}}"
        loading="{{seatsLoading}}"
        bind:change="onSearchChange"
        bind:search="onSearchConfirm"
      />
    </view>
    <view class="filter-left">
      <van-button icon="filter-o" size="small" class="filter-button" bind:tap="onFilterTap">
        {{filterText}}
      </van-button>
    </view>
  </view>

  <view class="search-loading" wx:if="{{seatsLoading}}">
    <van-loading type="spinner" size="20" />
    <text class="search-loading-text">加载中...</text>
  </view>

  <view class="filter-summary">
    <text class="filter-summary-text">{{filterResultText}}：{{seatCount}}</text>
  </view>

  <!-- 筛选条件面板 -->
  <view class="filter-panel" wx:if="{{showFilterPanel}}">
    <common-card>
      <view class="filter-panel-title">{{filterConditionsText}}</view>

      <!-- 区域和座位类型 -->
      <view class="filter-row">
        <view class="filter-item">
          <view class="filter-label">{{filterAreaText}}</view>
          <view class="filter-selector" bind:tap="onAreaTap">
            <text class="selector-text">{{selectedArea.name}}</text>
            <uni-icon type="vant" name="arrow" size="24" />
          </view>
        </view>

        <view class="filter-item">
          <view class="filter-label">{{filterSeatTypeText}}</view>
          <view class="filter-selector" bind:tap="onSeatTypeTap">
            <text class="selector-text">{{selectedSeatType.name}}</text>
            <uni-icon type="vant" name="arrow" size="24" />
          </view>
        </view>
      </view>

      <!-- 设施选项 -->
      <view class="filter-item">
        <view class="filter-label">{{filterFacilityText}}</view>
        <view class="facility-options">
          <view class="facility-item {{facilities.power ? 'active' : ''}}">
            <van-checkbox
              checked="{{facilities.power}}"
              shape="square"
              icon-size="32rpx"
              class="facility-checkbox"
              data-type="power"
              bind:change="onFacilityTap"
            />
            <text class="facility-label">{{filterFacilityPowerText}}</text>
          </view>
          <view class="facility-item {{facilities.window ? 'active' : ''}}">
            <van-checkbox
              checked="{{facilities.window}}"
              shape="square"
              icon-size="32rpx"
              class="facility-checkbox"
              data-type="window"
              bind:change="onFacilityTap"
            />
            <text class="facility-label">{{filterFacilityWindowText}}</text>
          </view>
        </view>
      </view>

      <!-- 重置按钮 -->
      <view class="filter-actions">
        <text class="reset-button" bind:tap="onResetFilter">{{filterResetText}}</text>
      </view>
    </common-card>
  </view>

  <!-- 座位列表区域 -->
  <view>
    <!-- 座位选择组件 -->
    <seats-select
      seats="{{seats}}"
      selectedSeats="{{selectedSeatIds}}"
      theme="{{theme}}"
      currentLang="{{currentLang}}"
      bind:seatSelect="onSeatSelect"
      bind:seatTap="onSeatTap"
      bind:error="onSeatError"
    />

    <!-- 座位信息卡片 -->
    <view
      class="seat-info-popover {{popoverDirection}}"
      wx:if="{{selectedSeatInfo}}"
      style="{{seatInfoPopoverStyle}}"
    >
      <view class="seat-info-popover-arrow"></view>
      <view class="seat-info-card">
        <view class="seat-info-header">
          <view>
            <text class="seat-info-title"
              >{{selectedSeatInfo.seatName || selectedSeatInfo.row + '-' +
              selectedSeatInfo.col}}</text
            >
            <text class="seat-info-subtitle">{{selectedSeatInfo.zone || ''}}</text>
          </view>
          <view class="seat-info-close" bind:tap="onCloseSeatInfo">
            <text class="iconfont icon-close"></text>
          </view>
        </view>
        <view class="seat-info-body">
          <view class="seat-info-row">
            <text class="seat-info-label">{{t('reservation.info.status')}}</text>
            <text class="seat-info-value">{{selectedSeatInfo.statusText}}</text>
          </view>
          <view class="seat-info-row" wx:if="{{selectedSeatInfo.type}}">
            <text class="seat-info-label">{{t('reservation.info.type')}}</text>
            <text class="seat-info-value">{{selectedSeatInfo.type}}</text>
          </view>
          <view class="seat-info-row" wx:if="{{selectedSeatInfo.hasSocket}}">
            <text class="seat-info-label">{{t('reservation.info.facility')}}</text>
            <text class="seat-info-value">{{selectedSeatInfo.hasSocketText}}</text>
          </view>
          <view class="seat-info-row" wx:if="{{selectedSeatInfo.isWindow}}">
            <text class="seat-info-label">{{t('reservation.info.window')}}</text>
            <text class="seat-info-value">{{selectedSeatInfo.isWindowText}}</text>
          </view>
          <view class="seat-info-row" wx:if="{{selectedSeatInfo.bookedTimeRange}}">
            <text class="seat-info-label">{{t('reservation.info.bookedTimeRange')}}</text>
            <text class="seat-info-value">{{selectedSeatInfo.bookedTimeRange}}</text>
          </view>
          <view class="seat-info-row" wx:if="{{selectedSeatInfo.description}}">
            <text class="seat-info-label">{{t('reservation.info.description')}}</text>
            <text class="seat-info-value">{{selectedSeatInfo.description}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 预约确认模块 -->
    <view
      class="reservation-confirm-section"
      wx:if="{{selectedSeatIds.length > 0 || currentTimePeriod === 'custom'}}"
    >
      <view class="confirm-card">
        <view class="confirm-title">{{confirmTitleText}}</view>

        <!-- 确认信息列表 -->
        <view class="confirm-info-list">
          <block wx:for="{{reservationInfoItems}}" wx:key="label">
            <view class="confirm-info-item" wx:if="{{item.label !== t('reservation.confirm.fee')}}">
              <text class="info-label">{{item.label}}</text>
              <text class="info-value">{{item.value}}</text>
            </view>
          </block>
        </view>

        <!-- 确认按钮 -->
        <view class="confirm-button" bind:tap="onConfirmReservation">{{confirmButtonText}}</view>
      </view>
    </view>
  </view>
</view>
