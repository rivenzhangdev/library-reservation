<!-- 预约页面 -->
<page-meta>
  <navigation-bar title="{{navTitle}}" back="{{false}}" />
</page-meta>

<view class="page-container {{languageClass}}">
  <!-- 楼层选择区域 -->
  <view class="floor-section">
    <view class="section-title">{{floorSelectText}}</view>
    <scroll-view class="floor-tags" scroll-x enable-flex>
      <view
        wx:for="{{floors}}"
        wx:key="id"
        class="floor-tag {{currentFloor === item.id ? 'active' : ''}}"
        bind:tap="onFloorTap"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </scroll-view>
  </view>

  <!-- 时间选择模块（移到最上方） -->
  <view class="time-selection-section">
    <view class="section-title">{{timeSelectText}}</view>

    <!-- 日期选择 -->
    <view class="date-picker">
      <van-cell-group>
        <van-field
          readonly
          model:value="{{selectedDate}}"
          placeholder="{{t('reservation.time.date.placeholder')}}"
          bind:click="onDateClick"
          is-link
          right-icon="calendar-o"
        />
      </van-cell-group>
    </view>

    <!-- 时段选择 -->
    <view class="time-period-section">
      <view class="section-subtitle">{{timePeriodText}}</view>
      <view class="time-period-options">
        <block wx:for="{{timePeriods}}" wx:key="value">
          <view
            class="time-period-option {{currentTimePeriod === item.value ? 'active' : ''}}"
            bind:tap="onTimePeriodTap"
            data-value="{{item.value}}"
          >
            <view class="time-period-label">{{item.label}}</view>
            <view class="time-period-range">{{item.start}} - {{item.end}}</view>
          </view>
        </block>
      </view>

      <!-- 自定义时间段入口 -->
      <view
        class="custom-time-toggle"
        wx:if="{{!showCustomTime && currentTimePeriod !== 'custom'}}"
        bind:tap="toggleCustomTime"
      >
        <uni-icon type="vant" name="edit" size="24" color="var(--common-primary-color)" />
        <text class="custom-time-text">{{customTimeConfirmText}}</text>
      </view>

      <!-- 自定义时间段面板 -->
      <view class="custom-time-panel" wx:if="{{showCustomTime}}">
        <view class="custom-time-inputs">
          <view class="custom-time-input">
            <view class="custom-time-label">{{customTimeStartText}}</view>
            <picker
              mode="time"
              value="{{startTime}}"
              bind:change="onStartTimeChange"
              class="time-picker"
            >
              <view class="picker-display">
                <text>{{startTime}}</text>
                <uni-icon type="vant" name="clock-o" size="24" />
              </view>
            </picker>
          </view>

          <view class="custom-time-input">
            <view class="custom-time-label">{{customTimeEndText}}</view>
            <picker
              mode="time"
              value="{{endTime}}"
              bind:change="onEndTimeChange"
              class="time-picker"
            >
              <view class="picker-display">
                <text>{{endTime}}</text>
                <uni-icon type="vant" name="clock-o" size="24" />
              </view>
            </picker>
          </view>
        </view>

        <view class="custom-time-confirm" bind:tap="onConfirmCustomTime">
          {{customTimeConfirmText}}
        </view>
      </view>

      <!-- 取消自定义时间段 -->
      <view class="cancel-custom-time" wx:if="{{showCustomTime}}" bind:tap="toggleCustomTime">
        <uni-icon type="vant" name="delete-o" size="24" />
        <text class="cancel-custom-text">{{customTimeCancelText}}</text>
      </view>
    </view>

    <!-- 时长选择 -->
    <view class="duration-section">
      <view class="section-subtitle">{{timeDurationText}}</view>
      <view class="duration-options">
        <block wx:for="{{durations}}" wx:key="value">
          <view
            class="duration-option {{currentDuration === item.value ? 'active' : ''}}"
            bind:tap="onDurationTap"
            data-value="{{item.value}}"
          >
            {{item.label}}
          </view>
        </block>
      </view>
    </view>

    <!-- 当前预约时间显示 -->
    <view class="current-time-display">
      <text class="current-time-label">{{timeRangeLabelText}}</text>
      <text class="current-time-value">{{customTimePeriodText}}</text>
    </view>
  </view>

  <!-- 筛选按钮 -->
  <view class="filter-bar">
    <view class="filter-left">
      <van-button icon="filter-o" size="small" class="filter-button" bind:tap="onFilterTap">
        {{filterText}}
      </van-button>
    </view>
  </view>

  <!-- 筛选条件面板 -->
  <view class="filter-panel" wx:if="{{showFilterPanel}}">
    <common-card>
      <view class="filter-panel-title">{{filterConditionsText}}</view>

      <!-- 区域和座位类型 -->
      <view class="filter-row">
        <view class="filter-item">
          <view class="filter-label">{{filterAreaText}}</view>
          <view class="filter-selector" bind:tap="onAreaTap">
            <text class="selector-text">{{selectedArea.name}}</text>
            <uni-icon type="vant" name="arrow" size="24" />
          </view>
        </view>

        <view class="filter-item">
          <view class="filter-label">{{filterSeatTypeText}}</view>
          <view class="filter-selector" bind:tap="onSeatTypeTap">
            <text class="selector-text">{{selectedSeatType.name}}</text>
            <uni-icon type="vant" name="arrow" size="24" />
          </view>
        </view>
      </view>

      <!-- 设施选项 -->
      <view class="filter-item">
        <view class="filter-label">{{filterFacilityText}}</view>
        <view class="facility-options">
          <view class="facility-item" bind:tap="onFacilityTap" data-type="power">
            <van-checkbox
              checked="{{facilities.power}}"
              shape="square"
              icon-size="32rpx"
              class="facility-checkbox"
            />
            <text class="facility-label">{{filterFacilityPowerText}}</text>
          </view>
          <view class="facility-item" bind:tap="onFacilityTap" data-type="window">
            <van-checkbox
              checked="{{facilities.window}}"
              shape="square"
              icon-size="32rpx"
              class="facility-checkbox"
            />
            <text class="facility-label">{{filterFacilityWindowText}}</text>
          </view>
        </view>
      </view>

      <!-- 重置按钮 -->
      <view class="filter-actions">
        <text class="reset-button" bind:tap="onResetFilter">{{filterResetText}}</text>
      </view>
    </common-card>
  </view>

  <!-- 座位列表区域 -->
  <view>
    <!-- 座位选择组件 -->
    <seats-select
      seats="{{seats}}"
      selectedSeats="{{selectedSeatIds}}"
      theme="{{theme}}"
      currentLang="{{currentLang}}"
      bind:seatSelect="onSeatSelect"
      bind:error="onSeatError"
    />

    <!-- 预约确认模块 -->
    <view
      class="reservation-confirm-section"
      wx:if="{{selectedSeatIds.length > 0 || currentTimePeriod === 'custom'}}"
    >
      <view class="confirm-card">
        <view class="confirm-title">{{confirmTitleText}}</view>

        <!-- 确认信息列表 -->
        <view class="confirm-info-list">
          <block wx:for="{{reservationInfoItems}}" wx:key="label">
            <view class="confirm-info-item" wx:if="{{item.label !== t('reservation.confirm.fee')}}">
              <text class="info-label">{{item.label}}</text>
              <text class="info-value">{{item.value}}</text>
            </view>
          </block>
        </view>

        <!-- 确认按钮 -->
        <view class="confirm-button" bind:tap="onConfirmReservation">{{confirmButtonText}}</view>
      </view>
    </view>
  </view>
</view>
