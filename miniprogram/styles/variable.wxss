page {
  /* ========================================
   * 页面基础变量
   * ======================================== */
  --common-page-padding: var(--common-spacing-xl);
  --common-page-bg-color: #f5f5f5;

  /* ========================================
   * 间距变量系统（统一使用新命名）
   * ======================================== */

  /* 标准化间距系统 */
  --common-spacing-xs: 4rpx;
  --common-spacing-sm: 8rpx;
  --common-spacing-md: 12rpx;
  --common-spacing-lg: 16rpx;
  --common-spacing-xl: 20rpx;
  --common-spacing-2xl: 24rpx;
  --common-spacing-3xl: 28rpx;
  --common-spacing-4xl: 32rpx;
  --common-spacing-5xl: 40rpx;

  /* ========================================
   * 颜色变量系统
   * ======================================== */

  /* 基础色 */
  --common-white-color: #fff;
  --common-black-color: #000;
  --common-gray-color: #f5f5f5;

  /* 主题色 */
  --common-primary-color: #409eff;
  --common-success-color: #2ecc71;
  --common-warning-color: #e6a23c;
  --common-danger-color: #e74c3c;
  --common-info-color: #3498db;

  /* 文字颜色 */
  --common-dark-text-color: #333;
  --common-regular-text-color: #666;
  --common-hint-text-color: #999;

  /* 背景色 */
  --common-hover-bg-color: #f5f5f5;
  --common-info-bg-color: #ecf5ff;

  /* 装饰色 */
  --common-gold-color: #ffd700;
  --common-border-color: #f0f0f0;
  --common-light-border-color: #e9ecef;

  /* 状态颜色（通用语义化命名，可用于任何业务场景） */
  --common-status-success-color: var(--common-success-color);
  --common-status-success-border-color: #16a34a;
  --common-status-success-active-color: #22c55e;
  --common-status-danger-color: var(--common-danger-color);
  --common-status-danger-border-color: #dc2626;
  --common-status-warning-color: var(--common-warning-color);
  --common-status-warning-border-color: #f59e0b;
  --common-status-info-color: var(--common-info-color);
  --common-status-info-border-color: #2563eb;
  --common-status-gray-color: var(--common-gray-color);
  --common-status-gray-border-color: #6b7280;
  --common-status-purple-color: #a855f7;
  --common-status-purple-border-color: #9333ea;

  /* 渐变色 */
  --common-primary-gradient: linear-gradient(135deg, #2e5cff 0%, #8b3dff 100%);
  --common-purple-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --common-pink-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  --common-blue-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);

  /* ========================================
   * 圆角变量系统（统一使用新命名）
   * ======================================== */
  --common-border-radius-sm: 4rpx;
  --common-border-radius-md: 8rpx;
  --common-border-radius-lg: 12rpx;
  --common-border-radius-xl: 16rpx;
  --common-border-radius-2xl: 20rpx;
  --common-border-radius-pill: 9999rpx;

  /* ========================================
   * 阴影变量系统
   * ======================================== */
  --common-shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  --common-shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --common-shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  --common-shadow-xl: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  --common-shadow-primary: 0 8rpx 32rpx rgba(46, 92, 255, 0.3);

  /* ========================================
   * 字体大小变量系统（统一使用新命名）
   * ======================================== */
  --common-font-size-xs: 20rpx;
  --common-font-size-sm: 22rpx;
  --common-font-size-md: 24rpx;
  --common-font-size-lg: 26rpx;
  --common-font-size-xl: 28rpx;
  --common-font-size-2xl: 30rpx;
  --common-font-size-3xl: 32rpx;
  --common-font-size-4xl: 36rpx;
  --common-font-size-5xl: 40rpx;

  /* ========================================
   * 字重变量系统
   * ======================================== */
  --common-font-weight-normal: 400;
  --common-font-weight-medium: 500;
  --common-font-weight-bold: 600;
  --common-font-weight-semibold: 600;

  /* ========================================
   * 按钮变量系统
   * ======================================== */
  --button-small-width: 160rpx;
  --button-medium-height: 60rpx;
  --tag-min-width: 120rpx;
  --filter-option-min-width: 160rpx;

  /* ========================================
   * 图标尺寸变量系统（统一使用新命名）
   * ======================================== */
  --icon-size-xs: 24rpx;
  --icon-size-sm: 28rpx;
  --icon-size-md: 32rpx;
  --icon-size-lg: 40rpx;
  --icon-size-xl: 48rpx;
  --icon-size-2xl: 60rpx;
  --icon-size-3xl: 72rpx;
  --icon-size-4xl: 80rpx;
  --icon-size-5xl: 160rpx;

  /* ========================================
   * 卡片变量系统
   * ======================================== */
  --card-padding: var(--common-spacing-4xl);
  --card-header-margin-bottom: var(--common-spacing-2xl);

  /* ========================================
   * 导航栏变量系统
   * ======================================== */
  --nav-bar-height: 44px;
  --nav-bar-android-height: 48px;
  --nav-bar-left-margin: -11px;
  --nav-bar-left-padding: 11px 18px 11px 16px;
  --nav-bar-icon-size: 12px;
  --nav-bar-icon-width: 12px;
  --nav-bar-icon-height: 24px;
  --nav-bar-title-size: 17px;
  --nav-bar-title-margin-right: 4px;
  --nav-bar-loading-size: 16px;
  --nav-bar-loading-width: 16px;
  --nav-bar-loading-height: 16px;

  /* ========================================
   * 过渡动画变量系统
   * ======================================== */
  --transition-fast: 0.15s;
  --transition-normal: 0.2s;
  --transition-slow: 0.3s;

  /* ========================================
   * 边框变量系统
   * ======================================== */
  --common-border-width: 1rpx;

  /* ========================================
   * 卡片背景渐变色
   * ======================================== */
  --card-gradient-a: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}
