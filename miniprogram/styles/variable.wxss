page {
  /* 间距相关 */
  --common-page-padding: 20rpx;
  --common-mini-gap: 8rpx;
  --common-gap: 12rpx;
  --common-large-gap: 16rpx;

  /* 颜色相关 */
  --common-gray-color: #f5f5f5;
  --common-card-bg-color: #fff;
  --common-text-color: #333;
  --common-secondary-text-color: #666;
  --common-primary-color: #409eff;

  /* 边框圆角相关 */
  --common-mini-border-radius: 4rpx;
  --common-border-radius: 8rpx;
  --common-large-border-radius: 12rpx;

  /* 阴影相关 */
  --common-box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);

  /* 字体大小相关 */
  --common-mini-font-size: 16rpx;
  --common-font-size: 24rpx;
  --common-large-font-size: 32rpx;
  
  /* 按钮相关 */
  --button-small-width: 160rpx;
  --tag-min-width: 120rpx;
  --filter-option-min-width: 160rpx;
}
