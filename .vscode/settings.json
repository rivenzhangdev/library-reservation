{
  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "stylelint.validate": ["css", "scss", "less", "wxss"],
  "files.associations": {
    "*.wxss": "css",
    "*.wxml": "html",
    "*.scss": "scss"
  }
}
